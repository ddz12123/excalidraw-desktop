{
  "name": "excalidraw-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first offline Excalidraw desktop app",
  "author": "ddz12123 <ddz12123@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/ddz12123/excalidraw-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddz12123/excalidraw-desktop.git"
  },
  "main": "./out/main/index.js",
  "prettier": "@excalidraw/prettier-config",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "pnpm build && node scripts/package.mjs --win --x64",
    "preview": "electron-vite preview",
    "dist": "pnpm build && node scripts/package.mjs",
    "test": "vitest",
    "test:app": "vitest",
    "test:update": "vitest --update",
    "test:typecheck": "tsc",
    "test:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx .",
    "test:other": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore --list-different",
    "test:all": "pnpm test:typecheck && pnpm test:code && pnpm test:other",
    "fix:code": "eslint --max-warnings=0 --ext .js,.ts,.tsx . --fix",
    "fix:other": "prettier \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore --write",
    "fix": "pnpm fix:other && pnpm fix:code"
  },
  "devDependencies": {
    "@excalidraw/eslint-config": "1.0.3",
    "@excalidraw/prettier-config": "1.0.2",
    "@testing-library/jest-dom": "6.10.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "^10.1.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "3.3.1",
    "fake-indexeddb": "3.1.7",
    "jsdom": "30.1.3",
    "pepjs": "0.5.3",
    "prettier": "2.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.5",
    "vitest-canvas-mock": "0.3.3"
  },
  "build": {
    "appId": "com.ddz12123.excalidraw-desktop",
    "productName": "Excalidraw",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "ddz12123",
      "repo": "excalidraw-desktop",
      "releaseType": "release"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Excalidraw",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${os}-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Local-first offline whiteboard"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "electron-updater": "6.8.11",
    "zod": "4.6.7"
  }
}
